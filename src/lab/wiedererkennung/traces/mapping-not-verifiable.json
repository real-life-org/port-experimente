{
  "name": "mapping-not-verifiable",
  "shows": "A mapping reaches a device that cannot verify it. Nothing changes and nothing is acknowledged; the sender keeps owing it until a device that can verify fetches it.",
  "setup": {
    "tuples": [
      "t1",
      "t2"
    ]
  },
  "steps": [
    {
      "open": "t1",
      "on": "a1",
      "effect": true,
      "after": {
        "relationships": [
          [
            "t1"
          ]
        ],
        "stillOwed": {
          "a": [],
          "b": []
        }
      }
    },
    {
      "open": "t2",
      "on": "a1",
      "effect": true,
      "after": {
        "relationships": [
          [
            "t1"
          ],
          [
            "t2"
          ]
        ],
        "stillOwed": {
          "a": [],
          "b": []
        }
      }
    },
    {
      "open": "t2",
      "on": "b1",
      "effect": true,
      "after": {
        "relationships": [
          [
            "t2"
          ]
        ],
        "stillOwed": {
          "a": [],
          "b": []
        }
      }
    },
    {
      "fetchProbe": "t2",
      "on": "b1",
      "effect": true,
      "after": {
        "relationships": [
          [
            "t2"
          ]
        ],
        "stillOwed": {
          "a": [],
          "b": []
        }
      }
    },
    {
      "sync": "b1",
      "to": "b2",
      "effect": true,
      "after": {
        "relationships": [
          [
            "t2"
          ]
        ],
        "stillOwed": {
          "a": [],
          "b": []
        }
      }
