        "relationships": [
          [
            "t1"
          ],
          [
            "t2"
          ]
        ],
        "stillOwed": {
          "a": [],
          "b": [
            "t1+t2"
          ]
        }
      }
    },
    {
      "fetchMapping": "t1+t2",
