{
  "name": "met-again",
  "shows": "Two people who share a tuple meet again, one device each. Both proofs cross; one contact.",
  "setup": {
    "tuples": [
      "t1",
      "t2"
    ]
  },
  "steps": [
    {
      "open": "t1",
      "on": "a1",
      "effect": true
    },
    {
      "open": "t2",
      "on": "a1",
      "effect": true
    },
    {
      "open": "t1",
      "on": "b1",
      "effect": true
    },
    {
      "open": "t2",
      "on": "b1",
      "effect": true
    },
    {
      "fetchProbe": "t1",
      "on": "a1",
      "effect": true
    },
    {
      "fetchProbe": "t2",
      "on": "a1",
      "effect": true
    },
    {
      "sync": "a1",
      "to": "a2",
      "effect": true
    },
    {
      "fetchProbe": "t1",
      "on": "b1",
      "effect": true
    },
    {
      "fetchProbe": "t2",
      "on": "b1",
      "effect": true
    },
    {
      "fetchMapping": "t1+t2",
      "on": "a1",
      "effect": true
    },
    {
      "sync": "a1",
      "to": "a2",
      "effect": true
    },
    {
      "fetchMapping": "t1+t2",
      "on": "b1",
      "effect": true
    },
    {
      "sync": "b1",
      "to": "b2",
      "effect": true
    }
  ],
  "expect": {
