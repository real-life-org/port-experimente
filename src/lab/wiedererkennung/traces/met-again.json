        ]
      ],
      "a2": [
        [
          "t1",
          "t2"
        ]
      ],
      "b1": [
        [
          "t1",
          "t2"
        ]
      ],
      "b2": [
        [
          "t1",
          "t2"
        ]
      ]
    },
    "candidates": {
      "a": {
        "t1": [],
        "t2": [
          "t1"
        ]
      },
      "b": {
        "t1": [],
        "t2": [
          "t1"
        ]
      }
    },
    "stillOwed": {
      "a": [],
      "b": []
    }
