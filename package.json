{
  "name": "port-experimente",
  "private": true,
  "version": "0.0.0",
  "description": "Prüfstand: Gruppen-Autorität und Schlüsselvereinbarung verschiedener Kandidaten unter gleichen Szenarien",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "wasm": "sh scripts/build-wasm.sh",
    "test:rust": "cargo +1.96 test --manifest-path rust/p2panda-wasm/Cargo.toml --test peer && cargo +1.96 test --manifest-path rust/beekem-wasm/Cargo.toml",
    "server:fetch": "sh scripts/fetch-subduction.sh"
  },
  "dependencies": {
    "@automerge/automerge": "3.3.2",
    "@automerge/automerge-repo": "2.6.0-subduction.48",
    "@automerge/automerge-repo-keyhive": "0.6.0-alpha.1",
    "@automerge/automerge-subduction": "0.16.1",
    "@keyhive/keyhive": "0.3.0-alpha.1",
    "@web_of_trust/adapter-yjs": "0.3.0",
    "@web_of_trust/core": "0.6.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.0"
  }
}
